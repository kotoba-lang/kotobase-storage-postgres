{:paths ["src" "resources"]
 :deps {io.github.kotoba-lang/kotobase-storage
        {:git/url "https://github.com/kotoba-lang/kotobase-storage.git"
         :git/sha "b507198f4a27b71196d8b6e212451fe8edd3393e"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :integration
  {:extra-paths ["test-integration"]
   :extra-deps {org.postgresql/postgresql {:mvn/version "42.7.7"}}
   :main-opts ["-m" "kotobase.storage.postgres-integration"]}}}
